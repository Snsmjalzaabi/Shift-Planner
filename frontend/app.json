{
  "expo": {
    "name": "Foxory Shift Calendar",
    "slug": "foxory-shift-calendar",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "foxory",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foxory.shiftcalendar"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.foxory.shiftcalendar",
      "versionCode": 5
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-mail-composer",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Foxory Shift Calendar to choose a schedule image for local import.",
          "cameraPermission": "Allow Foxory Shift Calendar to photograph a schedule for local import.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c83e1f59-1a5c-4386-b391-d70022b16e0d"
      }
    },
    "owner": "snsmjalzaabi"
  }
}
