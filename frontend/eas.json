{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://shift-planner-hymq.onrender.com"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "channel": "production"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "http://localhost:8090"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "channel": "preview"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6809169441"
      }
    }
  }
}
